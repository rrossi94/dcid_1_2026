@file(compile.tcl) 6: file mkdir reports_${DESIGN}
@file(compile.tcl) 7: set csv_file [open "reports_${DESIGN}/resumen_barrido.csv" w]
@file(compile.tcl) 8: puts $csv_file "Freq_MHz,Periodo_ps,WNS_ps,Inst_Seq,Inst_Buf_Inv,Inst_Logic,Area_Total"
@file(compile.tcl) 10: foreach freq $freq_list {
    set period_ps [expr {1000000.0 / $freq}]
    
    delete_obj [find / -design *]
    read_hdl "${DESIGN}.v"
    elaborate $DESIGN
    
    create_clock -name "i_clock" -period $period_ps [get_ports i_clock]
    
    syn_generic
    syn_map
    syn_opt
    
    report_timing > "reports_${DESIGN}/timing_${freq}MHz.rpt"
    report_gates  > "reports_${DESIGN}/gates_${freq}MHz.rpt"
    
    set paths [get_db timing_paths]
    set wns [expr {$paths ne "" ? [lindex [get_db $paths .slack] 0] : "N/A"}]
    
    set seq_cnt  [llength [get_db insts -if {.is_sequential == true}]]
    set buf_cnt  [llength [get_db insts -if {.is_buffer == true || .is_inverter == true}]]
    set comb_cnt [llength [get_db insts -if {.is_combinational == true && .is_buffer == false && .is_inverter == false}]]
    set area_tot [get_db current_design .area]
    
    puts $csv_file "${freq},${period_ps},${wns},${seq_cnt},${buf_cnt},${comb_cnt},${area_tot}"
}
#@ End verbose source ./compile.tcl
